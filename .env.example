# Copy this file to .env and fill in values. Never commit .env.
ENVIRONMENT=dev

# "ollama" for local models, "openai_compat" for Groq / OpenRouter / Cerebras
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Free API option (pick one) ---
# Groq:       https://api.groq.com/openai/v1     model e.g. llama-3.3-70b-versatile
# OpenRouter: https://openrouter.ai/api/v1       model e.g. any model ending in :free
# Cerebras:   https://api.cerebras.ai/v1         model e.g. llama-3.3-70b
API_BASE_URL=https://api.groq.com/openai/v1
API_KEY=
API_MODEL=llama-3.3-70b-versatile

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opsmind
