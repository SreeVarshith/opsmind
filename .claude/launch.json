{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "opsmind-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "opsmind-ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "ui/streamlit_app.py", "--server.port", "8501",
                      "--server.address", "localhost", "--server.headless", "true",
                      "--browser.gatherUsageStats", "false"],
      "port": 8501
    },
    {
      "name": "opsmind-eval-progress",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "eval/progress_app.py", "--server.port", "8502",
                      "--server.address", "localhost", "--server.headless", "true",
                      "--browser.gatherUsageStats", "false"],
      "port": 8502
    },
    {
      "name": "opsmind-labeling",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "eval/label_app.py", "--server.port", "8503",
                      "--server.address", "localhost", "--server.headless", "true",
                      "--browser.gatherUsageStats", "false"],
      "port": 8503
    }
  ]
}
